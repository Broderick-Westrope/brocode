{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "permission": {
    "edit": {
      "packages/opencode/migration/*": "ask",
    },
  },
  "mcp": {
    "terminal": {
      "type": "local",
      "command": ["npx", "-y", "mcp-interactive-terminal"]
    }
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
  "experimental": {
    "defer_tools": true
  }
}
